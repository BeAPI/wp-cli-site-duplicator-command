<?xml version="1.0"?>
<ruleset name="WP-CLI Site Duplicator">
    <description>Coding standards for the WP-CLI Site Duplicator plugin</description>

    <file>.</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <!-- Show sniff codes and progress. -->
    <arg value="sp"/>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/.ddev/*</exclude-pattern>
    <!-- WordPress core downloaded by the e2e seed. -->
    <exclude-pattern>/tests/wordpress/*</exclude-pattern>

    <rule ref="WordPress-Extra">
        <!-- Class files are not named class-*.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Short array syntax is allowed. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <config name="minimum_wp_version" value="6.4"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
        <properties>
            <property name="blank_line_check" value="true"/>
        </properties>
    </rule>
</ruleset>
