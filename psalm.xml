<?xml version="1.0"?>
<psalm
    errorLevel="3"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <file name="wp-cli-site-duplicator-command.php"/>
        <directory name="classes"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php"/>
        <file name="vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php"/>
        <file name=".psalm/wordpress-constants.php"/>
    </stubs>

    <issueHandlers>
        <!-- The generated WordPress stubs carry docblocks Psalm cannot parse. -->
        <InvalidDocblock>
            <errorLevel type="suppress">
                <directory name="vendor"/>
            </errorLevel>
        </InvalidDocblock>
    </issueHandlers>
</psalm>
