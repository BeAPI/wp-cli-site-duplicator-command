{
	"name": "beapi/wp-cli-site-duplicator-command",
	"description": "A WP-CLI command for duplicating a site (blog) on a WordPress mutisite network",
	"minimum-stability": "stable",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "BeAPI",
			"email": "technique@beapi.fr"
		}
	],
	"type" : "wordpress-plugin",
	"require" : {
		"php": ">=8.2",
		"composer/installers": "^2.3"
	},
	"scripts": {
		"cs": "./vendor/bin/phpcs",
		"cbf": "./vendor/bin/phpcbf",
		"psalm": "./vendor/bin/psalm",
		"lint": "./vendor/bin/parallel-lint --exclude vendor --exclude tests/wordpress ."
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpro/grumphp-shim": true
		},
		"platform": {
			"php": "8.2.35"
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "3.13.6",
		"wp-coding-standards/wpcs": "3.4.1",
		"phpcompatibility/phpcompatibility-wp": "2.1.8",
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
		"vimeo/psalm": "7.9.0",
		"php-stubs/wordpress-stubs": "6.9.4",
		"php-stubs/wp-cli-stubs": "2.12.0",
		"phpro/grumphp-shim": "2.26.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"roave/security-advisories": "dev-latest"
	}
}
